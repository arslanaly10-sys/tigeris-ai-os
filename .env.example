# Owner connection: used only by migrations and seed. Never by the running API.
DATABASE_OWNER_URL=postgres://tigeris_owner:tigeris_owner_dev@localhost:5432/tigeris
# Application connection: non-owner role, no BYPASSRLS. All API traffic uses this.
DATABASE_APP_URL=postgres://tigeris_app:tigeris_app_dev@localhost:5432/tigeris
# Signs the demo session cookie. Replace outside local development.
SESSION_SECRET=dev-only-change-me-dev-only-change-me
# Seeded demonstration institution key.
DEMO_INSTITUTION_KEY=gsia-demo
API_PORT=4000
