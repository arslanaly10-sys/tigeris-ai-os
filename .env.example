# Owner connection: used only by migrations and seed. Never by the running API.
DATABASE_OWNER_URL=postgres://tigeris_owner:tigeris_owner_dev@localhost:5432/tigeris
# Application connection: non-owner role, no BYPASSRLS. All API traffic uses this.
DATABASE_APP_URL=postgres://tigeris_app:tigeris_app_dev@localhost:5432/tigeris
# Signs the demo session cookie. Replace outside local development.
SESSION_SECRET=dev-only-change-me-dev-only-change-me
# Seeded demonstration institution key.
DEMO_INSTITUTION_KEY=gsia-demo
API_PORT=4000
# Uploaded files are stored here, named by SHA-256. Defaults to apps/api/var/uploads.
UPLOAD_DIR=
# Set to false to run without the pg-boss job queue (scheduled connector syncs and crawls).
JOBS_ENABLED=true
# Optional model-provider endpoint. Shown as configured but never called: external model calls are off (D-14).
MODEL_PROVIDER_URL=

# Intervention alerts (Phase 5G). Off when empty. Never commit real values.
TEAMS_WEBHOOK_URL=
EMAIL_RELAY_URL=
EMAIL_RELAY_TOKEN=
EMAIL_TO=
APP_BASE_URL=http://127.0.0.1:5173

# Production sign-in (Phase 5H, OpenID Connect; Entra ID issuer: https://login.microsoftonline.com/<tenant>/v2.0).
# Off when OIDC_ISSUER is empty; the demo sign-in stays for the demonstration institution.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_INSTITUTION_KEY=gsia-demo
# Evidence store (Phase 5H): S3-compatible (MinIO, AWS S3). Files stay on local disk when the endpoint is empty.
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_BUCKET=tigeris-evidence
EVIDENCE_S3_REGION=us-east-1
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
# 127.0.0.1 locally, 0.0.0.0 in a container.
API_HOST=127.0.0.1
